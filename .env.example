# Copy to `.env` for local development. Never commit real keys.
# Expo only exposes variables prefixed with EXPO_PUBLIC_.

# https://www.football-data.org/client/register
EXPO_PUBLIC_FOOTBALL_DATA_API_KEY=
EXPO_PUBLIC_FOOTBALL_DATA_BASE_URL=https://api.football-data.org/v4

# https://www.api-football.com/ (or RapidAPI free tier)
EXPO_PUBLIC_API_FOOTBALL_API_KEY=
EXPO_PUBLIC_API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io

# https://the-odds-api.com/#get-access (~500 req/month free)
EXPO_PUBLIC_ODDS_API_KEY=
EXPO_PUBLIC_ODDS_API_BASE_URL=https://api.the-odds-api.com/v4
